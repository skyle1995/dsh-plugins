{
  "name": "dsh-plugin-repo",
  "version": "0.3.4",
  "description": "DSH 基础插件：设置面板的插件仓库（在线目录/安装/更新/卸载）、技能能力（skills 管理与导入）、规则（提示词）三个分区，以及会话右键菜单的删除会话",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/skills.js",
    "lib/session-archive.js",
    "lib/request.js",
    "lib/client.js",
    "lib/types/index.d.ts",
    "lib/types/skills.d.ts",
    "lib/types/session-archive.d.ts",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "smoke": "node test/smoke.mjs && node test/skills.smoke.mjs && node test/session-archive.smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2",
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "@types/react": "^19.0.0",
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://hub.ifunx.com/skyle1995/dsh-plugins.git",
    "directory": "packages/dsh-plugin-repo"
  }
}
