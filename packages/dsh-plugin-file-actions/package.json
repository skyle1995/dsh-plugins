{
  "name": "dsh-plugin-file-actions",
  "version": "0.2.2",
  "description": "DSH 文件列表增强插件：文件右键菜单（编辑/重命名/剪切/复制/粘贴/删除/压缩/复制路径）、Ctrl/Cmd 多选 + Shift 范围选择与批量操作栏",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/file-actions.js",
    "lib/zip.js",
    "lib/client.js",
    "lib/types/index.d.ts",
    "lib/types/file-actions.d.ts",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "smoke": "node test/smoke.mjs",
    "test": "node --test ../../demo-test/file-actions.test.mjs ../../demo-test/file-actions-client.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh": ">=0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@types/react": "^19.0.0",
    "esbuild": "^0.25.0",
    "puppeteer-core": "^25.13.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://hub.ifunx.com/skyle1995/dsh-plugins.git",
    "directory": "packages/dsh-plugin-file-actions"
  },
  "dependencies": {
    "prettier": "^3.9.9"
  }
}
