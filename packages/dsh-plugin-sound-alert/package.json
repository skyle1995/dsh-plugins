{
  "name": "dsh-plugin-sound-alert",
  "version": "0.2.1",
  "description": "DSH 手动交互提示音插件：Agent 停下来问你（选择方向 / 确认 / 审批）以及任务结束或停止时播放提示音；设置面板与「插件」页双入口，可按场景启用/关闭、替换为本地音频、恢复默认并试听",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "assets/attention.wav",
    "assets/done.wav",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "sounds": "node tools/generate-sounds.mjs",
    "smoke": "node test/smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2",
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://hub.ifunx.com/skyle1995/dsh-plugins.git",
    "directory": "packages/dsh-plugin-sound-alert"
  }
}
