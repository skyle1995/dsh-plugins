{
  "name": "dsh-plugin-message-recall",
  "version": "0.1.0",
  "description": "DSH 消息撤回插件：撤回助手消息并把该轮的工作区文件变更一起还原（浏览器操作 + 宿主路由）",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/capture.js",
    "lib/recall.js",
    "lib/client.js",
    "lib/types/index.d.ts",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "smoke": "node test/smoke.mjs && node test/engine.smoke.mjs && node test/persistence.smoke.mjs && node test/client.smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "@types/react": "^19.0.0",
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.0-rc.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://hub.ifunx.com/skyle1995/dsh-plugins.git",
    "directory": "packages/dsh-plugin-message-recall"
  }
}
