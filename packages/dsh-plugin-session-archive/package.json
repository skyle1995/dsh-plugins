{
  "name": "dsh-plugin-session-archive",
  "version": "0.1.0",
  "description": "会话归档：设置面板里的归档会话管理（归档 / 还原 / 删除，基于官方 ctx.workspaceRegistry 归档集）",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/index.d.ts",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "smoke": "node test/smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "@types/react": "^19.0.0",
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://hub.ifunx.com/skyle1995/dsh-plugins.git",
    "directory": "packages/dsh-plugin-session-archive"
  }
}
